# Supabase (Settings → API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random, at least 32 characters: openssl rand -hex 32
PARTICIPANT_SECRET=

# Password for the /research page
RESEARCH_KEY=

# Public site URL, e.g. https://swerve.app
NEXT_PUBLIC_SITE_URL=

# Email address for data requests, shown on /privacy
NEXT_PUBLIC_PRIVACY_CONTACT=

# Optional, once AdSense approves the site
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
